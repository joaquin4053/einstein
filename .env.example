# ── LLM (Apertus via any OpenAI-compatible provider) ─────────────────────
# Leave LLM_API_KEY empty to run in demo mode (rule-based agents, real SemOpenAlex data via MCP).
# Public AI:  https://api.publicai.co/v1   (key from https://platform.publicai.co)
# Swisscom / Infomaniak / self-hosted vLLM: set the provider's /v1 base URL.
LLM_BASE_URL=https://api.publicai.co/v1
LLM_API_KEY=
# Optional. Einstein tries this first, then the provider's Apertus models (largest,
# non-"thinking" first) and uses the first one that actually answers.
LLM_MODEL=

# ── SemOpenAlex (required) ──────────────────────────────────────────────
# Einstein queries SemOpenAlex only through its MCP server's tools
# (execute_sparql_query, entity_lookup, keyword_search, describe_entity).
# SEMOPENALEX_MCP_AUTH = full Authorization header value, e.g. "Basic <base64>"
# from the challenge's connector config. Alternatively SEMOPENALEX_MCP_KEY=user:password.
SEMOPENALEX_MCP_URL=https://semopenalex.org/mcp
SEMOPENALEX_MCP_AUTH=
SEMOPENALEX_MCP_KEY=

# ── Web-search fallback (optional) ──────────────────────────────────────
# When SemOpenAlex fails, the chat offers to let ChatGPT search the web for papers
# (OpenAI Responses API + web search, billed per use). Without a key it is not offered.
# Key from https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional, default gpt-5.4.
OPENAI_SEARCH_MODEL=
# The same key also stands in for the LLM above when it does not answer (or is
# not configured): all agents then run on this model (default gpt-5.4).
OPENAI_LLM_MODEL=

# ── Supabase (optional – without it runs are kept in the browser only) ─
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── metaphactory (local Docker, see README) ─────────────────────────────
# Einstein writes each run's evidence graph into metaphactory's GraphDB repository.
# Leave empty on Vercel – the containers only run on your machine.
METAPHACTORY_URL=http://localhost:10214
METAPHACTORY_GRAPHDB_URL=
